{
  "name": "@frizzyondabeat/volt-fast",
  "version": "1.0.4",
  "description": "a CLI tool for initial project setups and configurations including essential hooks and scripts",
  "type": "module",
  "bin": {
    "volt-fast": "./dist/cli.js",
    "volt-fast-mcp": "./dist/mcp-server.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --project tsconfig.test.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc",
    "prepack": "pnpm build"
  },
  "keywords": [
    "volt-fast",
    "cli",
    "project-setup",
    "configuration",
    "hooks",
    "scripts",
    "testing",
    "unit",
    "component",
    "e2e",
    "cypress",
    "vitest",
    "jest",
    "tailwindcss",
    "nextjs",
    "vite",
    "typescript",
    "react",
    "javascript",
    "cli-tool"
  ],
  "author": "Efeoghene Omonigho <omonigho.efeoghene@outlook.com> (https://efeoghene-omonigho.vercel.app)",
  "license": "ISC",
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0",
  "dependencies": {
    "@antfu/ni": "^23.3.1",
    "@clack/core": "^0.4.2",
    "@clack/prompts": "^0.10.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "boxen": "^8.0.1",
    "colorette": "^2.0.20",
    "commander": "^13.1.0",
    "consola": "^3.4.2",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.4",
    "gradient-string": "^3.0.0",
    "ora": "^8.2.0",
    "prettier": "^3.8.1",
    "strip-json-comments": "^5.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "vite": "8.0.10"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/frizzyondabeat/volt-fast.git"
  },
  "homepage": "https://voltfast.dev/",
  "bugs": {
    "url": "https://github.com/frizzyondabeat/volt-fast/issues",
    "email": "omonigho.efeoghene@outlook.com"
  }
}
